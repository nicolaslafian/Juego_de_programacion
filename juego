# =====================================
# SISTEMA DE PROGRESO
# =====================================
def cargar_progreso():
    if os.path.exists(PROGRESS_FILE):
        try:
            with open(PROGRESS_FILE, 'r') as f:
                return json.load(f)
        except:
            return {"nivel_1_completado": False, "nivel_2_completado": False}
    return {"nivel_1_completado": False, "nivel_2_completado": False}

def guardar_progreso(progreso):
    with open(PROGRESS_FILE, 'w') as f:
        json.dump(progreso, f)

# =====================================
# PARTÍCULAS
# =====================================
class Particle:
    def __init__(self, x, y):
        self.x = x
        self.y = y
        self.vel_x = random.uniform(-3, 3)
        self.vel_y = random.uniform(-8, -3)
        self.lifetime = 30
        self.size = random.randint(3, 6)
        self.color = AZUL_PARTICULA
    
    def update(self):
        self.x += self.vel_x
        self.y += self.vel_y
        self.vel_y += 0.3
        self.lifetime -= 1
        self.size = max(1, self.size - 0.1)
    
    def draw(self, screen, scroll_x):
        if self.lifetime > 0:
            pygame.draw.circle(screen, self.color, (int(self.x - scroll_x), int(self.y)), int(self.size))

# =====================================
# CORAZÓN
# =====================================
class Heart:
    def __init__(self, x, y):
        self.x = x
        self.y = y
        self.size = 20
        self.collected = False
        self.rect = pygame.Rect(x - self.size//2, y - self.size//2, self.size, self.size)
        self.float_offset = 0
        self.float_speed = 0.1
    
    def update(self):
        self.float_offset += self.float_speed
        if abs(self.float_offset) > 5:
            self.float_speed *= -1
    
    def draw(self, screen, scroll_x):
        if not self.collected:
            y_pos = self.y + self.float_offset
            pygame.draw.circle(screen, ROSA, (int(self.x - scroll_x - 6), int(y_pos - 3)), 8)
            pygame.draw.circle(screen, ROSA, (int(self.x - scroll_x + 6), int(y_pos - 3)), 8)
            points = [
                (self.x - scroll_x - 12, y_pos),
                (self.x - scroll_x, y_pos + 12),
                (self.x - scroll_x + 12, y_pos)
            ]
            pygame.draw.polygon(screen, ROSA, points)
    
    def check_collision(self, player_rect):
        if not self.collected:
            return self.rect.colliderect(player_rect)
        return False

# =====================================
# BANDERA DE CHECKPOINT
# =====================================
class CheckpointFlag:
    def __init__(self, x, y, platform_y):
        self.x = x
        self.platform_y = platform_y
        self.y = platform_y - 60
        self.width = 40
        self.height = 60
        self.pole_width = 5
        self.activated = False
        self.rect = pygame.Rect(x - 20, self.y, 50, 60)
    
    def draw(self, screen, scroll_x):
        pole_height = self.platform_y - self.y
        pygame.draw.rect(screen, MARRON, (self.x - scroll_x, self.y, self.pole_width, pole_height))
        
        color = VERDE_BANDERA if self.activated else ROJO_BANDERA
        flag_points = [
            (self.x + self.pole_width - scroll_x, self.y),
            (self.x + self.pole_width + 30 - scroll_x, self.y + 15),
            (self.x + self.pole_width - scroll_x, self.y + 30)
        ]
        pygame.draw.polygon(screen, color, flag_points)
    
    def check_collision(self, player_rect):
        return self.rect.colliderect(player_rect)

# =====================================
# BANDERA DE META (AMARILLA GRANDE)
# =====================================
class GoalFlag:
    def __init__(self, x, y):
        self.x = x
        self.y = y
        self.width = 80
        self.height = 120
        self.pole_width = 8
        self.rect = pygame.Rect(x - 20, y, 100, 120)
        self.wave_offset = 0
    
    def update(self):
        self.wave_offset += 0.1
    
    def draw(self, screen, scroll_x):
        # Poste grande
        pygame.draw.rect(screen, MARRON, (self.x - scroll_x, self.y, self.pole_width, self.height))
        
        # Bandera amarilla grande con efecto de ondulación
        flag_width = 60
        flag_height = 40
        
        # Dibujar bandera con efecto de onda
        for i in range(0, flag_width, 5):
            wave = int(3 * pygame.math.Vector2(1, 0).rotate(self.wave_offset * 50 + i * 10).y)
            x1 = self.x + self.pole_width - scroll_x + i
            y1 = self.y + 10 + wave
            x2 = self.x + self.pole_width - scroll_x + i + 5
            y2 = self.y + 10 + wave
            
            points = [
                (x1, y1),
                (x2, y2),
                (x2, y2 + flag_height),
                (x1, y1 + flag_height)
            ]
            pygame.draw.polygon(screen, AMARILLO, points)
        
        # Borde de la bandera
        pygame.draw.rect(screen, NEGRO, 
                        (self.x + self.pole_width - scroll_x, self.y + 10, flag_width, flag_height), 2)
    
    def check_collision(self, player_rect):
        return self.rect.colliderect(player_rect)

# =====================================
# PLAYER
# =====================================
class Player(pygame.sprite.Sprite):
    def __init__(self):
        super().__init__()
        self.image = pygame.Surface((40, 60))
        self.image.fill(ROJO)
        self.rect = self.image.get_rect()
        self.rect.x = 100
        self.rect.y = GROUND_HEIGHT - self.rect.height
        self.vel_y = 0
        self.en_suelo = False
        
        self.checkpoint_x = 100
        self.checkpoint_y = GROUND_HEIGHT - self.rect.height
        
        self.doble_salto_usado = False
        self.salto_pulsado_una_vez = False
        self.salto_pulsado_tiempo = 0
        
        self.inmortal = False
        
        self.muertes = 0
        self.vidas = 5
        self.vidas_max = 8
        
        self.particles = []

    def create_jump_particles(self):
        for _ in range(8):
            particle = Particle(self.rect.centerx, self.rect.bottom)
            self.particles.append(particle)

    def add_vida(self):
        if self.vidas < self.vidas_max:
            self.vidas += 1

    def update(self, plataformas, eventos):
        keys = pygame.key.get_pressed()
        if keys[pygame.K_a]:
            self.rect.x -= 5
        if keys[pygame.K_d]:
            self.rect.x += 5

        self.rect.x = max(0, min(self.rect.x, WORLD_WIDTH - self.rect.width))

        for event in eventos:
            if event.type == pygame.KEYDOWN and event.key == pygame.K_SPACE:
                tiempo_actual = time.time()
                if self.en_suelo:
                    self.vel_y = -15
                    self.en_suelo = False
                    self.doble_salto_usado = False
                    self.salto_pulsado_una_vez = True
                    self.salto_pulsado_tiempo = tiempo_actual
                    self.create_jump_particles()
                else:
                    if self.salto_pulsado_una_vez and (tiempo_actual - self.salto_pulsado_tiempo) <= 0.3:
                        if not self.doble_salto_usado:
                            self.vel_y = -15
                            self.doble_salto_usado = True
                            self.salto_pulsado_una_vez = False
                            self.create_jump_particles()
                    else:
                        self.salto_pulsado_una_vez = True
                        self.salto_pulsado_tiempo = tiempo_actual

        self.vel_y += 1
        self.rect.y += self.vel_y

        if self.rect.bottom > GROUND_HEIGHT and self.rect.x < ZONA_SEGURA_ANCHO:
            self.rect.bottom = GROUND_HEIGHT
            self.vel_y = 0
            self.en_suelo = True
            self.doble_salto_usado = False
            self.salto_pulsado_una_vez = False

        collided = False
        for p in plataformas:
            if self.rect.colliderect(p.rect) and self.vel_y > 0:
                self.rect.bottom = p.rect.top
                self.vel_y = 0
                self.en_suelo = True
                self.doble_salto_usado = False
                self.salto_pulsado_una_vez = False
                collided = True
        if not collided and self.rect.bottom < GROUND_HEIGHT:
            self.en_suelo = False
        
        for particle in self.particles[:]:
            particle.update()
            if particle.lifetime <= 0:
                self.particles.remove(particle)

    def reset_to_checkpoint(self):
        self.rect.x = self.checkpoint_x
        self.rect.y = self.checkpoint_y
        self.vel_y = 0
        self.en_suelo = False
        self.doble_salto_usado = False
        self.salto_pulsado_una_vez = False
        self.muertes += 1
        if not self.inmortal:
            self.vidas -= 1

    def toggle_inmortal(self):
        self.inmortal = not self.inmortal

    def draw_particles(self, screen, scroll_x):
        for particle in self.particles:
            particle.draw(screen, scroll_x)

