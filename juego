# =====================================
# DIBUJAR HUD
# =====================================
def draw_hud(player, nivel):
    fuente = pygame.font.SysFont(None, 30)
    
    # Nivel
    texto_nivel = fuente.render(f"Nivel {nivel}", True, MORADO if nivel == 2 else VERDE)
    screen.blit(texto_nivel, (WIDTH - 120, 10))
    
    # Contador de muertes
    texto_muertes = fuente.render(f"Muertes: {player.muertes}", True, NEGRO)
    screen.blit(texto_muertes, (10, 10))
    
    # Vidas con corazones
    corazon_size = 25
    for i in range(player.vidas):
        x = 10 + i * (corazon_size + 5)
        y = 45
        pygame.draw.circle(screen, ROSA, (x + 6, y + 3), 6)
        pygame.draw.circle(screen, ROSA, (x + 14, y + 3), 6)
        points = [(x + 2, y + 6), (x + 10, y + 16), (x + 18, y + 6)]
        pygame.draw.polygon(screen, ROSA, points)
    
    # Modo inmortal
    if player.inmortal:
        texto_inmortal = fuente.render("MODO INMORTAL", True, AMARILLO)
        rect_inmortal = texto_inmortal.get_rect(center=(WIDTH//2, 20))
        pygame.draw.rect(screen, NEGRO, rect_inmortal.inflate(20, 10))
        screen.blit(texto_inmortal, rect_inmortal)

# =====================================
# DIBUJAR PANTALLA
# =====================================
def draw_window(scroll_x, player, plataformas, obstaculos, goal_flag, checkpoints, hearts, nivel):
    screen.fill(AZUL_CIELO)

    pygame.draw.rect(screen, VERDE, (-scroll_x, GROUND_HEIGHT, ZONA_SEGURA_ANCHO, 50))

    for p in plataformas:
        screen.blit(p.image, (p.rect.x - scroll_x, p.rect.y))

    for o in obstaculos:
        screen.blit(o.image, (o.rect.x - scroll_x, o.rect.y))

    # Dibujar bandera de meta
    goal_flag.draw(screen, scroll_x)

    for checkpoint in checkpoints:
        checkpoint.draw(screen, scroll_x)

    for heart in hearts:
        heart.draw(screen, scroll_x)

    player.draw_particles(screen, scroll_x)

    screen.blit(player.image, (player.rect.x - scroll_x, player.rect.y))
    
    draw_hud(player, nivel)

