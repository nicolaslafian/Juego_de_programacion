# =====================================
# MENÚ PRINCIPAL
# =====================================
def menu_principal():
    fuente_titulo = pygame.font.SysFont(None, 80)
    fuente_boton = pygame.font.SysFont(None, 50)
    fuente_small = pygame.font.SysFont(None, 30)
    
    progreso = cargar_progreso()
    
    titulo = fuente_titulo.render("PARKOUR GAME", True, AMARILLO)
    titulo_rect = titulo.get_rect(center=(WIDTH//2, HEIGHT//3 - 30))
    
    boton_nivel1 = pygame.Rect(WIDTH//2 - 100, HEIGHT//2 - 40, 200, 60)
    boton_nivel2 = pygame.Rect(WIDTH//2 - 100, HEIGHT//2 + 40, 200, 60)
    
    while True:
        screen.fill(AZUL_CIELO)
        screen.blit(titulo, titulo_rect)
        
        mouse_pos = pygame.mouse.get_pos()
        mouse_click = False
        
        for event in pygame.event.get():
            if event.type == pygame.QUIT:
                pygame.quit()
                sys.exit()
            if event.type == pygame.MOUSEBUTTONDOWN:
                mouse_click = True
        
        # Botón Nivel 1
        color_boton1 = VERDE if boton_nivel1.collidepoint(mouse_pos) else MARRON
        pygame.draw.rect(screen, color_boton1, boton_nivel1, border_radius=10)
        pygame.draw.rect(screen, NEGRO, boton_nivel1, 3, border_radius=10)
        texto_boton1 = fuente_boton.render("NIVEL 1", True, BLANCO)
        texto_rect1 = texto_boton1.get_rect(center=boton_nivel1.center)
        screen.blit(texto_boton1, texto_rect1)
        
        # Botón Nivel 2 (bloqueado si no se completó nivel 1)
        nivel2_desbloqueado = progreso.get("nivel_1_completado", False)
        
        if nivel2_desbloqueado:
            color_boton2 = MORADO if boton_nivel2.collidepoint(mouse_pos) else MARRON
            pygame.draw.rect(screen, color_boton2, boton_nivel2, border_radius=10)
            pygame.draw.rect(screen, NEGRO, boton_nivel2, 3, border_radius=10)
            texto_boton2 = fuente_boton.render("NIVEL 2", True, BLANCO)
        else:
            pygame.draw.rect(screen, GRIS, boton_nivel2, border_radius=10)
            pygame.draw.rect(screen, NEGRO, boton_nivel2, 3, border_radius=10)
            texto_boton2 = fuente_boton.render("NIVEL 2", True, NEGRO)
            # Candado
            texto_bloqueado = fuente_small.render("🔒 Completa Nivel 1", True, ROJO)
            texto_bloq_rect = texto_bloqueado.get_rect(center=(WIDTH//2, boton_nivel2.bottom + 25))
            screen.blit(texto_bloqueado, texto_bloq_rect)
        
        texto_rect2 = texto_boton2.get_rect(center=boton_nivel2.center)
        screen.blit(texto_boton2, texto_rect2)
        
        # Instrucciones
        fuente_inst = pygame.font.SysFont(None, 22)
        inst1 = fuente_inst.render("A/D: Mover | SPACE: Saltar (doble salto) | I: Modo inmortal", True, NEGRO)
        inst2 = fuente_inst.render("Toca la bandera amarilla al final para ganar", True, NEGRO)
        screen.blit(inst1, (WIDTH//2 - inst1.get_width()//2, HEIGHT - 70))
        screen.blit(inst2, (WIDTH//2 - inst2.get_width()//2, HEIGHT - 40))
        
        if mouse_click:
            if boton_nivel1.collidepoint(mouse_pos):
                return 1
            elif boton_nivel2.collidepoint(mouse_pos) and nivel2_desbloqueado:
                return 2
        
        pygame.display.flip()
        clock.tick(60)

# =====================================
# PANTALLA DE GAME OVER
# =====================================
def pantalla_game_over(muertes, nivel):
    fuente = pygame.font.SysFont(None, 80)
    fuente_sub = pygame.font.SysFont(None, 40)
    texto = fuente.render("GAME OVER", True, ROJO)
    texto_nivel = fuente_sub.render(f"Nivel {nivel}", True, BLANCO)
    texto_muertes = fuente_sub.render(f"Muertes: {muertes}", True, BLANCO)
    texto_opciones = fuente_sub.render("R: Reintentar | M: Menú | Q: Salir", True, BLANCO)
    
    rect = texto.get_rect(center=(WIDTH//2, HEIGHT//2 - 70))
    rect_nivel = texto_nivel.get_rect(center=(WIDTH//2, HEIGHT//2 - 20))
    rect_muertes = texto_muertes.get_rect(center=(WIDTH//2, HEIGHT//2 + 20))
    rect_opciones = texto_opciones.get_rect(center=(WIDTH//2, HEIGHT//2 + 70))
    
    while True:
        screen.fill(NEGRO)
        screen.blit(texto, rect)
        screen.blit(texto_nivel, rect_nivel)
        screen.blit(texto_muertes, rect_muertes)
        screen.blit(texto_opciones, rect_opciones)
        pygame.display.flip()
        
        for event in pygame.event.get():
            if event.type == pygame.QUIT:
                pygame.quit()
                sys.exit()
            if event.type == pygame.KEYDOWN:
                if event.key == pygame.K_r:
                    return "retry"
                if event.key == pygame.K_m:
                    return "menu"
                if event.key == pygame.K_q:
                    pygame.quit()
                    sys.exit()

