# =====================================
# FUNCIÓN PRINCIPAL DEL JUEGO
# =====================================
def juego_principal(nivel):
    player = Player()
    
    if nivel == 1:
        plataformas, obstaculos, checkpoints, hearts, goal_flag = crear_nivel_1()
    else:
        plataformas, obstaculos, checkpoints, hearts, goal_flag = crear_nivel_2()

    running = True
    scroll_x = 0
    
    while running:
        clock.tick(60)
        eventos = pygame.event.get()
        
        for event in eventos:
            if event.type == pygame.QUIT:
                pygame.quit()
                sys.exit()

            if event.type == pygame.KEYDOWN and event.key == pygame.K_i:
                player.toggle_inmortal()

        player.update(plataformas, eventos)

        # Actualizar bandera de meta
        goal_flag.update()

        for heart in hearts:
            heart.update()

        for checkpoint in checkpoints:
            if checkpoint.check_collision(player.rect) and not checkpoint.activated:
                checkpoint.activated = True
                player.checkpoint_x = checkpoint.x
                player.checkpoint_y = checkpoint.y

        for heart in hearts:
            if heart.check_collision(player.rect):
                heart.collected = True
                player.add_vida()

        for o in obstaculos:
            if player.rect.colliderect(o.rect) and not player.inmortal:
                efecto_caida()
                player.reset_to_checkpoint()
                if player.vidas <= 0:
                    resultado = pantalla_game_over(player.muertes, nivel)
                    return resultado

        if player.rect.bottom > GROUND_HEIGHT and player.rect.x > ZONA_SEGURA_ANCHO and not player.inmortal:
            efecto_caida()
            player.reset_to_checkpoint()
            if player.vidas <= 0:
                resultado = pantalla_game_over(player.muertes, nivel)
                return resultado

        # Verificar colisión con bandera de meta
        if goal_flag.check_collision(player.rect):
            resultado = pantalla_victoria(player.muertes, nivel)
            return resultado

        scroll_x = player.rect.x - WIDTH // 2
        scroll_x = max(0, min(scroll_x, WORLD_WIDTH - WIDTH))

        draw_window(scroll_x, player, plataformas, obstaculos, goal_flag, checkpoints, hearts, nivel)
        pygame.display.flip()

# =====================================
# INICIO DEL JUEGO
# =====================================
while True:
    nivel_seleccionado = menu_principal()
    
    while True:
        resultado = juego_principal(nivel_seleccionado)
        
        if resultado == "retry":
            continue
        elif resultado == "menu":
            break
        else:
            break